# Copy to .env locally; loaded on server startup. Do not commit .env or paste keys in chat.
# Environment variables override .env values.
# Default: SQLite local operator demo. Never expose this unauthenticated prototype publicly.
# DATABASE_URL=postgresql+psycopg://printflow:change-me@localhost:5432/printflow
# DATA_DIR=./data

# Obtain a Meta Model API key with credits and access to the Standard-mode model.
META_API_KEY=
META_MODEL=muse-spark-1.3
SHOP_TIMEZONE=America/New_York

# Installed Windows Bambu Studio CLI (default auto-detection path).
# Use forward slashes in paths.
BAMBU_STUDIO_PATH=C:/Program Files/Bambu Studio/bambu-studio.exe
# Optional operator-maintained registry, otherwise profiles/registry.json.
# SLICER_PROFILE_MANIFEST=C:/path/to/registry.json
